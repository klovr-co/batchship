#!/bin/sh
# Managed by shiplane: the pre-push gate (.agents/shiplane/pre-push.mjs). Enabled per machine by
# `git config core.hooksPath .githooks` (shiplane setup does it). Never skip it with `git push --no-verify` (AGENTS.md).
# git hands the pushed refs on stdin once; keep them for each command below.
input=$(cat)
{{repoHook}}if [ -f .agents/shiplane/pre-push.mjs ]; then
  command -v node >/dev/null 2>&1 || { echo "pre-push: node is not on PATH; cannot run .agents/shiplane/pre-push.mjs" >&2; exit 1; }
  printf '%s\n' "$input" | node .agents/shiplane/pre-push.mjs --hook "$@" || exit 1
fi
# core.hooksPath replaces .git/hooks, so run git-lfs's pre-push here when the repo uses LFS.
if grep -qs 'filter=lfs' .gitattributes && command -v git-lfs >/dev/null 2>&1; then
  printf '%s\n' "$input" | git lfs pre-push "$@" || exit 1
fi
